{
  "uid": "factory-run",
  "title": "Factory run",
  "tags": [
    "factory"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Job ID",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "container",
        "label": "Container (Tetragon)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "description": "One factory job across three layers: the agent (Claude Code OpenTelemetry), the network (mitmproxy flow log) and the OS (Tetragon). The host prints a link with both variables filled in.",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Cost",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(sum_over_time({service_name=\"claude-code\"} | factory_job_id=\"$job\" | event_name=\"api_request\" | unwrap cost_usd [$__range])) or vector(0)",
          "queryType": "instant",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Model requests",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service_name=\"claude-code\"} | factory_job_id=\"$job\" | event_name=\"api_request\" [$__range])) or vector(0)",
          "queryType": "instant",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Tool calls",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service_name=\"claude-code\"} | factory_job_id=\"$job\" | event_name=\"tool_result\" [$__range])) or vector(0)",
          "queryType": "instant",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Egress allowed",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service_name=\"factory-proxy\"} | json | job_id=\"$job\" | allowed=\"true\" | kind!=\"telemetry\" [$__range])) or vector(0)",
          "queryType": "instant",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Egress blocked",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service_name=\"factory-proxy\"} | json | job_id=\"$job\" | allowed=\"false\" [$__range])) or vector(0)",
          "queryType": "instant",
          "instant": true
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Processes started",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service_name=\"factory-tetragon\"} | container=\"$container\" |= \"process_exec\" [$__range])) or vector(0)",
          "queryType": "instant",
          "instant": true
        }
      ]
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Agent: prompts, model calls, tool calls (Claude Code OTel)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Ascending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"claude-code\"} | factory_job_id=\"$job\" | line_format \"{{.event_name}}  {{.tool_name}} {{.tool_input}}{{.model}} {{.cost_usd}}\"",
          "queryType": "range",
          "maxLines": 2000
        }
      ]
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Network: every request through the proxy",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Ascending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"factory-proxy\"} | json | job_id=\"$job\" | kind!=\"telemetry\" | line_format `{{if eq .allowed \"true\"}}ALLOW{{else}}BLOCK{{end}}  {{.method}} {{.host}}{{.path}}  \u2192 {{.status}}`",
          "queryType": "range",
          "maxLines": 2000
        }
      ]
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Network: blocked egress only",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Ascending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"factory-proxy\"} | json | job_id=\"$job\" | allowed=\"false\" | line_format \"BLOCK  {{.method}} {{.host}}  ({{.kind}})\"",
          "queryType": "range",
          "maxLines": 2000
        }
      ]
    },
    {
      "id": 10,
      "type": "logs",
      "title": "OS: processes started in the job container (Tetragon)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Ascending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"factory-tetragon\"} | container=\"$container\" |= \"process_exec\" | json bin=\"process_exec.process.binary\", args=\"process_exec.process.arguments\" | line_format \"{{.bin}} {{.args}}\"",
          "queryType": "range",
          "maxLines": 2000
        }
      ]
    },
    {
      "id": 11,
      "type": "logs",
      "title": "OS: outbound connects and sensitive file opens (Tetragon)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Ascending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"factory-tetragon\"} | container=\"$container\" |= \"process_kprobe\" | json fn=\"process_kprobe.function_name\", bin=\"process_kprobe.process.binary\", addr=\"process_kprobe.args[0].sockaddr_arg.addr\", port=\"process_kprobe.args[0].sockaddr_arg.port\", path=\"process_kprobe.args[0].file_arg.path\" | line_format \"{{.fn}}  {{.bin}}  {{.addr}}{{if .port}}:{{.port}}{{end}}{{.path}}\"",
          "queryType": "range",
          "maxLines": 2000
        }
      ]
    },
    {
      "id": 12,
      "type": "table",
      "title": "Traces: one per agent turn (click a trace ID for the waterfall)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.factory.job_id = \"$job\" }",
          "limit": 50,
          "tableType": "traces"
        }
      ]
    }
  ]
}
